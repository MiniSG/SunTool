<UserControl x:Class="SunTool.Modules.MemoryWatch.Views.MemoryWatchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:SunTool.Wpf.Localization;assembly=SunTool.Wpf"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SunTool.Modules.MemoryWatch.ViewModels"
             xmlns:logic="clr-namespace:SunTool.Modules.MemoryWatch.Logic"
             xmlns:v="clr-namespace:SunTool.Modules.MemoryWatch.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MemoryWatchViewModel}"
             d:DesignWidth="1150" d:DesignHeight="760">

    <UserControl.Resources>
        <!-- 판정 배지 -->
        <Style x:Key="VerdictBadge" TargetType="{x:Type Border}">
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="8,1" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="#EEF0F3" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Verdict}" Value="{x:Static logic:TrendVerdict.Rising}">
                    <Setter Property="Background" Value="{StaticResource WarningSoftBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Verdict}" Value="{x:Static logic:TrendVerdict.Stable}">
                    <Setter Property="Background" Value="#E6F4EA" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="VerdictText" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Verdict}" Value="{x:Static logic:TrendVerdict.Rising}">
                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Verdict}" Value="{x:Static logic:TrendVerdict.Stable}">
                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 그래프 카드 -->
        <DataTemplate x:Key="ChartCard" DataType="{x:Type vm:ChartCardViewModel}">
            <Border Style="{StaticResource Card}" Margin="0,0,10,10" Padding="12,10">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                        <Border DockPanel.Dock="Right" Style="{StaticResource VerdictBadge}"
                                Visibility="{Binding ShowVerdict, Converter={StaticResource BoolToVis}}"
                                ToolTip="{l:T '참고용 판정입니다. 아래 근거를 함께 보세요.'}">
                            <TextBlock Text="{Binding VerdictText}" Style="{StaticResource VerdictText}" />
                        </Border>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <ItemsControl ItemsSource="{Binding Legend}" VerticalAlignment="Center"
                                      Visibility="{Binding ShowLegend, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:LegendItem}">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                                        <Rectangle Width="14" Height="3" Fill="{Binding Color}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource HintText}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding StatsText}" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,0,0,4"
                               Visibility="{Binding HasData, Converter={StaticResource BoolToVis}}" />
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding TrendText}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                               Visibility="{Binding HasData, Converter={StaticResource BoolToVis}}" />
                    <v:MiniChart MinHeight="90"
                                 Samples="{Binding DataContext.Samples, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                 Events="{Binding DataContext.Events, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                 Revision="{Binding DataContext.Revision, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                 Metrics="{Binding Metrics}" Colors="{Binding Colors}" />
                </DockPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <!-- 창이 작으면 그래프가 찌그러지지 않도록 최소 높이를 두고 스크롤 -->
    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid MinHeight="700" Height="{Binding ViewportHeight, ElementName=Scroller}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== ① 대상과 설정 ===== -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,10" Padding="14,10">
            <StackPanel>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="{l:T '감시 시작'}" Command="{Binding ToggleWatchCommand}" Style="{StaticResource AccentButton}" MinWidth="110"
                                Visibility="{Binding CanEditSetup, Converter={StaticResource BoolToVis}}" />
                        <Button Content="{l:T '감시 중지'}" Command="{Binding ToggleWatchCommand}" Style="{StaticResource DangerButton}" MinWidth="110"
                                Visibility="{Binding IsWatching, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                    <WrapPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,2,18,2" IsEnabled="{Binding CanEditSetup}">
                            <TextBlock Text="{l:T '간격'}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ComboBox ItemsSource="{Binding Intervals}" SelectedValuePath="Value" DisplayMemberPath="Text"
                                      SelectedValue="{Binding IntervalSeconds}" Width="80" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2,18,2"
                                    ToolTip="{l:T '처음 이 시간은 프로그램이 자리 잡는 중이라 판정에서 뺍니다 (그래프와 CSV 에는 모두 남음).'}">
                            <TextBlock Text="{l:T '워밍업'}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox Text="{Binding WarmupMinutes, Converter={StaticResource IntText}, UpdateSourceTrigger=PropertyChanged, Delay=500}" Width="45" />
                            <TextBlock Text="{l:T '분 제외'}" VerticalAlignment="Center" Margin="4,0,0,0" />
                        </StackPanel>
                        <CheckBox Content="{l:T '같은 이름으로 다시 켜지면 이어서 감시'}" IsChecked="{Binding FollowRestart}" VerticalAlignment="Center" Margin="0,2,0,2"
                                  ToolTip="{l:T '프로그램이 죽었다가 다시 켜져도 계속 기록합니다. 종료·다시 시작은 그래프에 세로선으로 표시됩니다.'}" />
                    </WrapPanel>
                </DockPanel>

                <!-- 프로그램 목록 (감시 중에는 숨김) -->
                <DockPanel Margin="0,10,0,0" Visibility="{Binding ShowProcessList, Converter={StaticResource BoolToVis}}">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Content="{l:T '새로고침'}" Command="{Binding RefreshProcessesCommand}" Padding="10,3" Margin="8,0,0,0" />
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" Width="260" HorizontalAlignment="Left"
                                 ToolTip="{l:T '프로그램 이름, 창 제목, PID 로 찾기'}" />
                        <TextBlock Text="{l:T '감시할 프로그램을 고르세요 (메모리 많이 쓰는 순)'}" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="12,0,0,0" />
                    </DockPanel>
                    <DataGrid ItemsSource="{Binding ProcessesView}" SelectedItem="{Binding SelectedProcess}" Height="150"
                              AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single"
                              GridLinesVisibility="Horizontal" CanUserResizeRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{l:T '프로그램'}" Binding="{Binding Name}" Width="200" />
                            <DataGridTextColumn Header="PID" Binding="{Binding Id}" Width="70" />
                            <DataGridTextColumn Header="{l:T '커밋'}" Binding="{Binding MemoryText}" Width="110" />
                            <DataGridTextColumn Header="{l:T '창 제목'}" Binding="{Binding WindowTitle}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>

                <!-- 감시 정보 -->
                <DockPanel Margin="0,10,0,0" Visibility="{Binding HasRecords, Converter={StaticResource BoolToVis}}">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <ToggleButton Content="{l:T '프로그램 목록'}" IsChecked="{Binding IsPickerOpen}" Padding="10,3" Margin="8,0,0,0"
                                      ToolTip="{l:T '다른 프로그램을 감시하려면 목록을 열어 고르세요'}"
                                      Visibility="{Binding CanTogglePicker, Converter={StaticResource BoolToVis}}" />
                        <Button Content="{l:T 'CSV 폴더 열기'}" Command="{Binding OpenCsvFolderCommand}" Padding="10,3" Margin="8,0,0,0" />
                        <Button Content="{l:T 'CSV로 저장'}" Command="{Binding SaveCsvCommand}" Padding="10,3" Margin="8,0,0,0" />
                        <Button Content="{l:T '기록 지우기'}" Command="{Binding ClearRecordsCommand}" Padding="10,3" Margin="8,0,0,0" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock>
                            <Run Text="{l:T '대상'}" Foreground="{StaticResource TextSecondaryBrush}" /><Run Text="  " /><Run Text="{Binding TargetText, Mode=OneWay}" FontWeight="SemiBold" />
                            <Run Text="   " /><Run Text="{Binding ProgressText, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}" />
                        </TextBlock>
                        <TextBlock Text="{Binding CsvPath}" Style="{StaticResource HintText}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" ToolTip="{Binding CsvPath}" />
                        <TextBlock Text="{Binding SystemCommitText}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"
                                   ToolTip="{l:T '컴퓨터 전체 프로그램이 확보한 메모리 합계와 한도입니다 (리소스 모니터의 커밋 비용). 판정하지 않고 참고로만 보여 줍니다.'}"
                                   Visibility="{Binding SystemCommitText, Converter={StaticResource NotEmptyToVis}}">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SystemCommitNearLimit}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding AccessWarning}" Foreground="{StaticResource WarningBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"
                                   Visibility="{Binding AccessWarning, Converter={StaticResource NotEmptyToVis}}" />
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- ===== ② 그래프 6개 ===== -->
        <ItemsControl Grid.Row="2" ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource ChartCard}" Margin="0,0,-10,-10">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="3" Rows="2" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>

        <!-- ===== ③ 안내와 상태 ===== -->
        <StackPanel Grid.Row="3" Margin="0,8,0,0">
            <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap"
                       Text="{l:T '판정은 참고용입니다. 같은 작업을 반복하는 동안 바닥선(구간별 최저값)이 꾸준히 오르는지로 판단하며, 처음 워밍업 시간은 뺍니다. 커밋·커널 풀·가상 크기는 워밍업 뒤 30분, 핸들·GDI·USER·스레드는 10분 이상 봐야 판정합니다. 가상 크기는 32비트 프로그램만 판정합니다. 원인 위치는 VMMap·UMDH·PerfView·dotMemory 같은 도구로 확인하세요.'}" />
            <TextBlock Text="{Binding StatusText}" Margin="0,4,0,0" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="{x:Type TextBlock}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
    </Grid>
    </ScrollViewer>
</UserControl>
