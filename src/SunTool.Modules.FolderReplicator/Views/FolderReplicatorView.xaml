<UserControl x:Class="SunTool.Modules.FolderReplicator.Views.FolderReplicatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:SunTool.Wpf.Localization;assembly=SunTool.Wpf"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SunTool.Modules.FolderReplicator.ViewModels"
             xmlns:b="clr-namespace:SunTool.Wpf.Behaviors;assembly=SunTool.Wpf"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:FolderReplicatorViewModel}"
             d:DesignWidth="1000" d:DesignHeight="700">

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="2*" MinWidth="340" />
        </Grid.ColumnDefinitions>

        <!-- ===== 왼쪽: 원본 폴더 + 트리 ===== -->
        <Border Grid.Column="0" Style="{StaticResource Card}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" Text="{l:T '① 원본 폴더'}" />

                <Border DockPanel.Dock="Top" Style="{StaticResource DropZone}" Margin="0,0,0,10"
                        b:DropBehavior.Command="{Binding DropSourceCommand}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="{l:T '찾아보기...'}" Command="{Binding BrowseSourceCommand}" VerticalAlignment="Center" />
                        <TextBlock DockPanel.Dock="Left" Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="26"
                                   Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="2,0,12,0" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{l:T '탐색기에서 원본 폴더를 여기로 끌어다 놓으세요'}" Style="{StaticResource HintText}" />
                            <TextBlock Text="{Binding SourcePath, TargetNullValue={l:T '(지정 안 됨)'}}" FontWeight="SemiBold" Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding SourcePath}" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Button Content="{l:T '전체 선택'}" Command="{Binding SelectAllCommand}" Margin="0,0,6,4" />
                    <Button Content="{l:T '선택 해제'}" Command="{Binding ClearSelectionCommand}" Margin="0,0,6,4" />
                    <Button Content="{l:T '모두 펼치기'}" Command="{Binding ExpandAllCommand}" Margin="0,0,6,4" />
                    <Button Content="{l:T '모두 접기'}" Command="{Binding CollapseAllCommand}" Margin="0,0,6,4" />
                    <Button Content="{l:T '다시 읽기'}" Command="{Binding RescanCommand}" Margin="0,0,6,4" />
                </WrapPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <TextBlock Text="{Binding SelectionSummary}" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,3,0,0"
                               Text="{l:T '폴더마다 버튼을 눌러 복사 방식을 정하세요: 폴더만 생성 → 폴더+파일 복사 → 제외(하위 폴더까지). 우클릭하면 하위 폴더까지 한 번에 적용합니다.'}" />
                </StackPanel>

                <TreeView ItemsSource="{Binding RootNodes}"
                          BorderBrush="{StaticResource LineBrush}"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="{x:Type TreeViewItem}">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            <Setter Property="Padding" Value="2,1" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate DataType="{x:Type vm:FolderNodeViewModel}" ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal" Background="Transparent">
                                <StackPanel.Style>
                                    <Style TargetType="{x:Type StackPanel}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsHidden}" Value="True">
                                                <Setter Property="Opacity" Value="0.55" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <StackPanel.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{l:T '이 폴더와 하위 폴더: 폴더+파일'}" Command="{Binding CheckSubtreeCommand}" />
                                        <MenuItem Header="{l:T '이 폴더와 하위 폴더: 폴더만'}" Command="{Binding UncheckSubtreeCommand}" />
                                        <MenuItem Header="{l:T '이 폴더와 하위 폴더: 제외'}" Command="{Binding ExcludeSubtreeCommand}" />
                                        <MenuItem Header="{l:T '바로 아래 하위 폴더만: 폴더+파일'}" Command="{Binding CheckChildrenCommand}" />
                                        <Separator />
                                        <MenuItem Header="{l:T '하위 폴더 모두 펼치기'}" Command="{Binding ExpandSubtreeCommand}" />
                                    </ContextMenu>
                                </StackPanel.ContextMenu>
                                <Button Command="{Binding CycleModeCommand}" VerticalAlignment="Center" Margin="0,0,8,0"
                                        Padding="6,1" MinWidth="92" HorizontalContentAlignment="Left"
                                        ToolTip="{l:T '클릭하면 복사 방식이 바뀝니다: 폴더만 → 폴더+파일 → 제외'}">
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFolderAndFiles}" Value="True">
                                                        <Setter Property="TextElement.Foreground" Value="{StaticResource AccentBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsExcluded}" Value="True">
                                                        <Setter Property="TextElement.Foreground" Value="{StaticResource DangerBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="{Binding ModeGlyph}" FontFamily="{StaticResource IconFont}" FontSize="13"
                                                   VerticalAlignment="Center" Margin="0,0,5,0" />
                                        <TextBlock Text="{Binding ModeLabel}" FontSize="12" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" Foreground="#D4A017"
                                           VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="10,0,0,0" />
                                <TextBlock Text="{l:T '  읽기 실패'}" Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center"
                                           Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" ToolTip="{Binding Error}" />
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </DockPanel>
        </Border>

        <!-- ===== 오른쪽: 대상/옵션/실행 ===== -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="{l:T '② 목적 폴더'}" />
                        <Border Style="{StaticResource DropZone}" b:DropBehavior.Command="{Binding DropDestinationCommand}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="{l:T '찾아보기...'}" Command="{Binding BrowseDestinationCommand}" VerticalAlignment="Center" />
                                <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="{l:T '폴더를 끌어다 놓거나 찾아보기'}" Style="{StaticResource HintText}" />
                                    <TextBlock Text="{Binding DestinationPath, TargetNullValue={l:T '(지정 안 됨)'}}" FontWeight="SemiBold" Margin="0,2,0,0"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding DestinationPath}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <CheckBox Content="{l:T '원본 폴더 이름으로 최상위 폴더 만들기'}" IsChecked="{Binding CreateRootFolder}" Margin="0,10,0,0" />
                        <TextBlock Text="{Binding TargetPreview}" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="{l:T '③ 복사 옵션'}" />
                        <TextBlock Text="{l:T '같은 이름의 파일이 이미 있으면'}" Style="{StaticResource FieldLabel}" Margin="0,0,0,3" />
                        <ComboBox ItemsSource="{Binding ConflictPolicies}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                  SelectedValue="{Binding ConflictPolicy}" />
                        <TextBlock Text="{l:T '복사할 확장자 (예: jpg;png — 비우면 전체)'}" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding ExtensionFilter, UpdateSourceTrigger=PropertyChanged, Delay=300}" />
                        <CheckBox Content="{l:T '숨김/시스템 폴더와 파일 제외'}" IsChecked="{Binding SkipHidden}" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="{l:T '④ 실행'}" />
                        <TextBlock Text="{Binding PlanSummary}" TextWrapping="Wrap" Margin="0,0,0,10" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}"
                                   Visibility="{Binding PlanSummary, Converter={StaticResource NotEmptyToVis}}" />
                        <WrapPanel>
                            <Button Content="{l:T '미리 계산'}" Command="{Binding PreviewCommand}" Margin="0,0,6,6"
                                    ToolTip="{l:T '실제로 복사하지 않고 생성될 폴더/파일 수를 계산합니다.'}" />
                            <Button Content="{l:T '실행'}" Command="{Binding ExecuteCommand}" Style="{StaticResource AccentButton}" Margin="0,0,6,6" />
                            <Button Content="{l:T '취소'}" Command="{Binding CancelCommand}" Style="{StaticResource DangerButton}" Margin="0,0,6,6" />
                            <Button Content="{l:T '목적 폴더 열기'}" Command="{Binding OpenDestinationCommand}" Margin="0,0,6,6" />
                        </WrapPanel>
                        <ProgressBar Value="{Binding ProgressValue, Mode=OneWay}" Maximum="100"
                                     IsIndeterminate="{Binding IsProgressIndeterminate}" Margin="0,6,0,6" />
                        <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Style="{StaticResource HintText}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
