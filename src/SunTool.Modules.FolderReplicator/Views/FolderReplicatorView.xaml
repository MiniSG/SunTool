<UserControl x:Class="SunTool.Modules.FolderReplicator.Views.FolderReplicatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SunTool.Modules.FolderReplicator.ViewModels"
             xmlns:b="clr-namespace:SunTool.Wpf.Behaviors;assembly=SunTool.Wpf"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:FolderReplicatorViewModel}"
             d:DesignWidth="1000" d:DesignHeight="700">

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="2*" MinWidth="340" />
        </Grid.ColumnDefinitions>

        <!-- ===== 왼쪽: 원본 폴더 + 트리 ===== -->
        <Border Grid.Column="0" Style="{StaticResource Card}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" Text="① 원본 폴더" />

                <Border DockPanel.Dock="Top" Style="{StaticResource DropZone}" Margin="0,0,0,10"
                        b:DropBehavior.Command="{Binding DropSourceCommand}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="찾아보기..." Command="{Binding BrowseSourceCommand}" VerticalAlignment="Center" />
                        <TextBlock DockPanel.Dock="Left" Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="26"
                                   Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="2,0,12,0" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="탐색기에서 원본 폴더를 여기로 끌어다 놓으세요" Style="{StaticResource HintText}" />
                            <TextBlock Text="{Binding SourcePath, TargetNullValue='(지정 안 됨)'}" FontWeight="SemiBold" Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding SourcePath}" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Button Content="전체 선택" Command="{Binding SelectAllCommand}" Margin="0,0,6,4" />
                    <Button Content="선택 해제" Command="{Binding ClearSelectionCommand}" Margin="0,0,6,4" />
                    <Button Content="모두 펼치기" Command="{Binding ExpandAllCommand}" Margin="0,0,6,4" />
                    <Button Content="모두 접기" Command="{Binding CollapseAllCommand}" Margin="0,0,6,4" />
                    <Button Content="다시 읽기" Command="{Binding RescanCommand}" Margin="0,0,6,4" />
                </WrapPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <TextBlock Text="{Binding SelectionSummary}" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,3,0,0"
                               Text="폴더 구조는 체크 여부와 상관없이 전부 만들어집니다. 체크한 폴더는 '바로 아래 파일'만 복사됩니다. 폴더를 우클릭하면 하위 폴더를 한 번에 선택할 수 있습니다." />
                </StackPanel>

                <TreeView ItemsSource="{Binding RootNodes}"
                          BorderBrush="{StaticResource LineBrush}"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="{x:Type TreeViewItem}">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            <Setter Property="Padding" Value="2,1" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate DataType="{x:Type vm:FolderNodeViewModel}" ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal" Background="Transparent">
                                <StackPanel.Style>
                                    <Style TargetType="{x:Type StackPanel}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsHidden}" Value="True">
                                                <Setter Property="Opacity" Value="0.55" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <StackPanel.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="이 폴더와 모든 하위 폴더 선택" Command="{Binding CheckSubtreeCommand}" />
                                        <MenuItem Header="이 폴더와 모든 하위 폴더 해제" Command="{Binding UncheckSubtreeCommand}" />
                                        <MenuItem Header="바로 아래 하위 폴더만 선택" Command="{Binding CheckChildrenCommand}" />
                                        <Separator />
                                        <MenuItem Header="하위 폴더 모두 펼치기" Command="{Binding ExpandSubtreeCommand}" />
                                    </ContextMenu>
                                </StackPanel.ContextMenu>
                                <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" Foreground="#D4A017"
                                           VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="10,0,0,0" />
                                <TextBlock Text="  읽기 실패" Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center"
                                           Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" ToolTip="{Binding Error}" />
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </DockPanel>
        </Border>

        <!-- ===== 오른쪽: 대상/옵션/실행 ===== -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="② 목적 폴더" />
                        <Border Style="{StaticResource DropZone}" b:DropBehavior.Command="{Binding DropDestinationCommand}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="찾아보기..." Command="{Binding BrowseDestinationCommand}" VerticalAlignment="Center" />
                                <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="폴더를 끌어다 놓거나 찾아보기" Style="{StaticResource HintText}" />
                                    <TextBlock Text="{Binding DestinationPath, TargetNullValue='(지정 안 됨)'}" FontWeight="SemiBold" Margin="0,2,0,0"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding DestinationPath}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <CheckBox Content="원본 폴더 이름으로 최상위 폴더 만들기" IsChecked="{Binding CreateRootFolder}" Margin="0,10,0,0" />
                        <TextBlock Text="{Binding TargetPreview}" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="③ 복사 옵션" />
                        <TextBlock Text="같은 이름의 파일이 이미 있으면" Style="{StaticResource FieldLabel}" Margin="0,0,0,3" />
                        <ComboBox ItemsSource="{Binding ConflictPolicies}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                  SelectedValue="{Binding ConflictPolicy}" />
                        <TextBlock Text="복사할 확장자 (예: jpg;png — 비우면 전체)" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding ExtensionFilter, UpdateSourceTrigger=PropertyChanged, Delay=300}" />
                        <CheckBox Content="숨김/시스템 폴더와 파일 제외" IsChecked="{Binding SkipHidden}" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="④ 실행" />
                        <TextBlock Text="{Binding PlanSummary}" TextWrapping="Wrap" Margin="0,0,0,10" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}"
                                   Visibility="{Binding PlanSummary, Converter={StaticResource NotEmptyToVis}}" />
                        <WrapPanel>
                            <Button Content="미리 계산" Command="{Binding PreviewCommand}" Margin="0,0,6,6"
                                    ToolTip="실제로 복사하지 않고 생성될 폴더/파일 수를 계산합니다." />
                            <Button Content="실행" Command="{Binding ExecuteCommand}" Style="{StaticResource AccentButton}" Margin="0,0,6,6" />
                            <Button Content="취소" Command="{Binding CancelCommand}" Style="{StaticResource DangerButton}" Margin="0,0,6,6" />
                            <Button Content="목적 폴더 열기" Command="{Binding OpenDestinationCommand}" Margin="0,0,6,6" />
                        </WrapPanel>
                        <ProgressBar Value="{Binding ProgressValue, Mode=OneWay}" Maximum="100"
                                     IsIndeterminate="{Binding IsProgressIndeterminate}" Margin="0,6,0,6" />
                        <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Style="{StaticResource HintText}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
