<Window x:Class="SunTool.App.Views.LogConsoleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:SunTool.Wpf.Localization;assembly=SunTool.Wpf"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SunTool.App.ViewModels"
        xmlns:conv="clr-namespace:SunTool.App.Converters"
        xmlns:log="clr-namespace:SunTool.Core.Logging;assembly=SunTool.Core"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:LogConsoleViewModel}"
        Title="{l:T 'SunTool 터미널'}"
        Icon="/SunTool;component/Assets/SunTool.ico"
        Width="1000" Height="560" MinWidth="600" MinHeight="300"
        WindowStartupLocation="CenterScreen"
        FontFamily="Malgun Gothic, Segoe UI" FontSize="12"
        Background="#0D1117" Foreground="#D0D7DE">

    <Window.Resources>
        <conv:LogLevelToBrushConverter x:Key="LevelBrush" />

        <Style x:Key="ConsoleButton" TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="#D0D7DE" />
            <Setter Property="Background" Value="#21262D" />
            <Setter Property="BorderBrush" Value="#30363D" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#30363D" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ConsoleCheck" TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="#D0D7DE" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>

        <Style x:Key="ConsoleText" TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="#010409" />
            <Setter Property="Foreground" Value="#D0D7DE" />
            <Setter Property="BorderBrush" Value="#30363D" />
            <Setter Property="CaretBrush" Value="#D0D7DE" />
            <Setter Property="Padding" Value="5,3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- 상단 도구 모음 -->
        <Border DockPanel.Dock="Top" Background="#161B22" BorderBrush="#30363D" BorderThickness="0,0,0,1" Padding="10,8">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="{l:T '표시'}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox ItemsSource="{Binding Levels}" DisplayMemberPath="Label" SelectedValuePath="Value"
                          SelectedValue="{Binding FilterLevel}" Width="120" Margin="0,0,12,0" />
                <TextBlock Text="{l:T '수집'}" VerticalAlignment="Center" Margin="0,0,6,0"
                           ToolTip="{l:T '로그 서비스가 기록하는 최소 레벨입니다. Trace 로 내리면 가장 자세히 기록합니다.'}" />
                <ComboBox ItemsSource="{Binding Levels}" DisplayMemberPath="Label" SelectedValuePath="Value"
                          SelectedValue="{Binding CollectLevel}" Width="120" Margin="0,0,12,0" />
                <TextBlock Text="{l:T '검색'}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}" Width="180" Margin="0,0,12,0"
                         Style="{StaticResource ConsoleText}" />
                <CheckBox Content="{l:T '자동 스크롤'}" IsChecked="{Binding AutoScroll}" Style="{StaticResource ConsoleCheck}" />
                <CheckBox Content="{l:T '일시 정지'}" IsChecked="{Binding IsPaused}" Style="{StaticResource ConsoleCheck}" />
                <Button Content="{l:T '지우기'}" Command="{Binding ClearCommand}" Style="{StaticResource ConsoleButton}" />
                <Button Content="{l:T '전체 복사'}" Command="{Binding CopyAllCommand}" Style="{StaticResource ConsoleButton}" />
                <Button Content="{l:T '파일로 저장'}" Command="{Binding SaveToFileCommand}" Style="{StaticResource ConsoleButton}" />
                <Button Content="{l:T '로그 폴더'}" Command="{Binding OpenLogFolderCommand}" Style="{StaticResource ConsoleButton}" />
            </WrapPanel>
        </Border>

        <!-- 하단: 명령 입력 + 상태 -->
        <Border DockPanel.Dock="Bottom" Background="#161B22" BorderBrush="#30363D" BorderThickness="0,1,0,0" Padding="10,6">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" Foreground="#8B949E" VerticalAlignment="Center" Margin="10,0,0,0" />
                <TextBlock DockPanel.Dock="Left" Text="&gt;" FontFamily="{StaticResource MonoFont}" FontSize="14" Foreground="#3FB950"
                           VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox x:Name="CommandInput"
                         Text="{Binding CommandText, UpdateSourceTrigger=PropertyChanged}"
                         FontFamily="{StaticResource MonoFont}" FontSize="13"
                         Style="{StaticResource ConsoleText}"
                         ToolTip="{l:T &quot;명령 입력 후 Enter ('help' 로 목록 확인, ↑↓ 이전 명령)&quot;}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding ExecuteCommandCommand}" />
                        <KeyBinding Key="Up" Command="{Binding HistoryPreviousCommand}" />
                        <KeyBinding Key="Down" Command="{Binding HistoryNextCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
            </DockPanel>
        </Border>

        <!-- 로그 목록 -->
        <ListBox x:Name="LogList"
                 ItemsSource="{Binding Entries}"
                 Background="#0D1117" BorderThickness="0"
                 FontFamily="{StaticResource MonoFont}" FontSize="12"
                 SelectionMode="Extended"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
                <Style TargetType="{x:Type ListBoxItem}">
                    <Setter Property="Padding" Value="8,1" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#161B22" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#1F3A5F" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type log:LogEntry}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="92" />
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding TimeText}" Foreground="#6E7681" />
                        <TextBlock Grid.Column="1" Text="{Binding LevelTag}" Foreground="{Binding Level, Converter={StaticResource LevelBrush}}" FontWeight="Bold" />
                        <TextBlock Grid.Column="2" Text="{Binding Source}" Foreground="#79C0FF" TextTrimming="CharacterEllipsis" ToolTip="{Binding Source}" />
                        <TextBlock Grid.Column="3" Text="{Binding FullText}" Foreground="{Binding Level, Converter={StaticResource LevelBrush}}" TextWrapping="Wrap" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
