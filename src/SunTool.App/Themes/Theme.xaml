<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:b="clr-namespace:SunTool.Wpf.Behaviors;assembly=SunTool.Wpf"
                    xmlns:conv="clr-namespace:SunTool.Wpf.Converters;assembly=SunTool.Wpf">

    <!-- ===== 색상 ===== -->
    <Color x:Key="AccentColor">#2F6FEB</Color>

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F3F4F6" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#F8F9FB" />
    <SolidColorBrush x:Key="LineBrush" Color="#D9DDE3" />
    <SolidColorBrush x:Key="LineStrongBrush" Color="#B8BFC9" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1F2328" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#6B7280" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#E8F0FE" />
    <SolidColorBrush x:Key="DangerBrush" Color="#D1242F" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#FDECEC" />
    <SolidColorBrush x:Key="WarningBrush" Color="#B7791F" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#FFF4E5" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#1A7F37" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#1F2430" />
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="#2A3140" />
    <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#343D50" />
    <SolidColorBrush x:Key="SidebarTextBrush" Color="#C9D1D9" />
    <SolidColorBrush x:Key="DropZoneBrush" Color="#F8FAFD" />

    <FontFamily x:Key="IconFont">Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="MonoFont">Consolas, D2Coding, Malgun Gothic</FontFamily>

    <!-- ===== 공용 변환기 (모든 모듈에서 사용) ===== -->
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <conv:BoolToVisibilityConverter x:Key="BoolToVisEx" />
    <conv:InverseBooleanConverter x:Key="InverseBool" />
    <conv:EnumToVisibilityConverter x:Key="EnumToVis" />
    <conv:NotEmptyToVisibilityConverter x:Key="NotEmptyToVis" />
    <conv:IntTextConverter x:Key="IntText" />

    <!-- ===== 기본 컨트롤 ===== -->
    <Style TargetType="{x:Type Window}">
        <Setter Property="FontFamily" Value="Malgun Gothic, Segoe UI" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.7" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AccentButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="18,7" />
    </Style>

    <Style x:Key="DangerButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
    </Style>

    <!-- 작은 아이콘 버튼 (Content 에 MDL2 글리프) -->
    <Style x:Key="IconButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Margin" Value="0,0,4,0" />
    </Style>

    <Style TargetType="{x:Type TextBox}">
        <Setter Property="Padding" Value="5,4" />
        <Setter Property="BorderBrush" Value="{StaticResource LineStrongBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style TargetType="{x:Type ComboBox}">
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style TargetType="{x:Type CheckBox}">
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,3" />
    </Style>

    <Style TargetType="{x:Type ProgressBar}">
        <Setter Property="Height" Value="8" />
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        <Setter Property="Background" Value="#E5E7EB" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- ===== 레이아웃 ===== -->
    <Style x:Key="Card" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="14" />
    </Style>

    <Style x:Key="SectionTitle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <Style x:Key="FieldLabel" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="Margin" Value="0,8,0,3" />
    </Style>

    <Style x:Key="HintText" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- 드롭 영역: 드래그 중이면 강조 -->
    <Style x:Key="DropZone" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource DropZoneBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineStrongBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="12" />
        <Style.Triggers>
            <Trigger Property="b:DropBehavior.IsDragOver" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== 사이드바 ===== -->
    <Style x:Key="SidebarItem" TargetType="{x:Type ListBoxItem}">
        <Setter Property="Foreground" Value="{StaticResource SidebarTextBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Border x:Name="Bd" Background="Transparent" Padding="14,10" Margin="6,2" CornerRadius="5">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SidebarHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SidebarSelectedBrush}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SidebarButton" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="{StaticResource SidebarTextBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Bd" Background="Transparent" Padding="14,9" Margin="6,2" CornerRadius="5">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SidebarHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
