<UserControl x:Class="SunTool.Modules.RemoteView.Views.RemoteViewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:SunTool.Wpf.Localization;assembly=SunTool.Wpf"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SunTool.Modules.RemoteView.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:RemoteViewViewModel}"
             d:DesignWidth="1050" d:DesignHeight="720">

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== ① 역할 + 안내 ===== -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,10" Padding="14,12">
            <StackPanel>
                <StackPanel Orientation="Horizontal" IsEnabled="{Binding CanEditMode}">
                    <TextBlock Text="{l:T '역할'}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0,0,14,0" />
                    <RadioButton Content="{l:T '내 화면 공유 (호스트)'}" IsChecked="{Binding IsHostMode}" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <RadioButton Content="{l:T '다른 PC 보기 (뷰어)'}" IsChecked="{Binding IsViewerMode}" VerticalAlignment="Center" />
                </StackPanel>
                <Border Background="#FFF6E5" CornerRadius="6" Padding="10,7" Margin="0,10,0,0">
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"
                               Text="{l:T '보기 전용입니다(마우스·키보드 제어 없음). 공유는 호스트가 직접 켜야 하고, PIN 이 맞아야 연결됩니다. 같은 네트워크(LAN)에서 평문으로 전송하니, 믿을 수 있는 네트워크에서만 쓰세요.'}" />
                </Border>
            </StackPanel>
        </Border>

        <!-- ===== ② 호스트(공유) ===== -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,10" Padding="14,12"
                Visibility="{Binding IsHostMode, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Content="{l:T '공유 시작'}" Command="{Binding StartHostCommand}" Style="{StaticResource AccentButton}" MinWidth="110"
                                Visibility="{Binding CanEditHostSetup, Converter={StaticResource BoolToVis}}" />
                        <Button Content="{l:T '공유 중지'}" Command="{Binding StopHostCommand}" Style="{StaticResource DangerButton}" MinWidth="110"
                                Visibility="{Binding IsHosting, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                    <WrapPanel IsEnabled="{Binding CanEditHostSetup}">
                        <StackPanel Orientation="Horizontal" Margin="0,2,18,2">
                            <TextBlock Text="{l:T '바인딩'}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ComboBox ItemsSource="{Binding BindOptions}" SelectedItem="{Binding SelectedBind}" MinWidth="170" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2,18,2">
                            <TextBlock Text="{l:T '포트'}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox Text="{Binding Port, Converter={StaticResource IntText}, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2,18,2">
                            <TextBlock Text="{l:T '해상도'}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ComboBox ItemsSource="{Binding ResolutionChoices}" SelectedItem="{Binding SelectedResolution}" MinWidth="120"
                                      ToolTip="{l:T '높일수록 선명하지만 용량·지연이 늘어납니다.'}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2,18,2">
                            <TextBlock Text="{l:T '화질'}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ComboBox ItemsSource="{Binding QualityChoices}" SelectedItem="{Binding Quality}" Width="64" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2,18,2">
                            <TextBlock Text="{l:T '초당 프레임'}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ComboBox ItemsSource="{Binding FpsChoices}" SelectedItem="{Binding FpsSetting}" Width="56" />
                        </StackPanel>
                    </WrapPanel>
                </DockPanel>

                <!-- 공유 정보 -->
                <Border Margin="0,10,0,0" Background="{StaticResource SurfaceAltBrush}" CornerRadius="6" Padding="12,10"
                        Visibility="{Binding IsHosting, Converter={StaticResource BoolToVis}}">
                    <WrapPanel>
                        <StackPanel Margin="0,0,30,0">
                            <TextBlock Text="{l:T '내 주소 (IP : 포트)'}" Style="{StaticResource HintText}" />
                            <TextBlock Text="{Binding MyIpText}" FontSize="18" FontWeight="SemiBold" FontFamily="{StaticResource MonoFont}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,30,0">
                            <TextBlock Text="{l:T 'PIN'}" Style="{StaticResource HintText}" />
                            <TextBlock Text="{Binding Pin}" FontSize="22" FontWeight="Bold" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource AccentBrush}" />
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{l:T '보는 사람'}" Style="{StaticResource HintText}" />
                            <TextBlock Text="{Binding ViewerCount}" FontSize="18" FontWeight="SemiBold" />
                        </StackPanel>
                    </WrapPanel>
                </Border>

                <TextBlock Text="{Binding HostStatus}" Margin="2,8,0,0" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HostStatusIsError}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- ===== ② 뷰어(보기) 설정 ===== -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,10" Padding="14,12"
                Visibility="{Binding IsViewerMode, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Content="{l:T '연결'}" Command="{Binding ConnectCommand}" Style="{StaticResource AccentButton}" MinWidth="90"
                            Visibility="{Binding CanEditViewerSetup, Converter={StaticResource BoolToVis}}" />
                    <Button Content="{l:T '전체 화면'}" Click="FullScreen_Click" MinWidth="90" Margin="0,0,8,0"
                            Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}"
                            ToolTip="{l:T '상대 화면을 전체 화면으로 봅니다 (Esc 로 닫기)'}" />
                    <Button Content="{l:T '연결 끊기'}" Command="{Binding DisconnectCommand}" Style="{StaticResource DangerButton}" MinWidth="90"
                            Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
                <WrapPanel IsEnabled="{Binding CanEditViewerSetup}">
                    <StackPanel Orientation="Horizontal" Margin="0,2,18,2">
                        <TextBlock Text="{l:T '호스트 IP'}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding HostAddress, UpdateSourceTrigger=PropertyChanged}" Width="150"
                                 ToolTip="{l:T '공유하는 PC 의 IP (상대 화면에 표시됨)'}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2,18,2">
                        <TextBlock Text="{l:T '포트'}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding ViewerPort, Converter={StaticResource IntText}, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2,18,2">
                        <TextBlock Text="{l:T 'PIN'}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding InputPin, UpdateSourceTrigger=PropertyChanged}" Width="90" FontFamily="{StaticResource MonoFont}" />
                    </StackPanel>
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- ===== ③ 원격 화면 (뷰어) ===== -->
        <Border Grid.Row="2" Background="#1E1E1E" CornerRadius="4"
                Visibility="{Binding IsViewerMode, Converter={StaticResource BoolToVis}}">
            <Grid>
                <TextBlock Text="{l:T '연결하면 상대 화면이 여기에 표시됩니다.'}" Foreground="#AAAAAA"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding NotConnected, Converter={StaticResource BoolToVis}}" />
                <Image Source="{Binding RemoteImage}" Stretch="Uniform" Margin="4" RenderOptions.BitmapScalingMode="HighQuality" />
            </Grid>
        </Border>

        <!-- ===== ④ 상태 (뷰어) ===== -->
        <DockPanel Grid.Row="3" Margin="2,8,0,0" Visibility="{Binding IsViewerMode, Converter={StaticResource BoolToVis}}">
            <ComboBox DockPanel.Dock="Left" ItemsSource="{Binding ViewMonitors}" SelectedItem="{Binding SelectedViewMonitor}" MinWidth="140" Margin="0,0,12,0"
                      VerticalAlignment="Center"
                      Visibility="{Binding ShowMonitorPicker, Converter={StaticResource BoolToVis}}"
                      ToolTip="{l:T '볼 모니터 고르기 (전체 또는 개별 모니터)'}" />
            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center"
                       Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}">
                <Run Text="{Binding RemoteSizeText, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Fps, Mode=OneWay}" /><Run Text="{l:T ' fps'}" />
            </TextBlock>
            <TextBlock Text="{Binding ViewerStatus}" TextWrapping="Wrap" VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="{x:Type TextBlock}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ViewerStatusIsError}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DockPanel>
    </Grid>
</UserControl>
