<UserControl x:Class="SunTool.Modules.NetScan.Views.NetScanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:SunTool.Wpf.Localization;assembly=SunTool.Wpf"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SunTool.Modules.NetScan.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:NetScanViewModel}"
             d:DesignWidth="1050" d:DesignHeight="720">

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== ① 범위와 설정 ===== -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,10" Padding="14,12">
            <StackPanel>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Content="{l:T '검색 시작'}" Command="{Binding StartScanCommand}" Style="{StaticResource AccentButton}" MinWidth="110"
                                Visibility="{Binding CanEditSetup, Converter={StaticResource BoolToVis}}" />
                        <Button Content="{l:T '중지'}" Command="{Binding StopScanCommand}" Style="{StaticResource DangerButton}" MinWidth="110"
                                Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                    <StackPanel IsEnabled="{Binding CanEditSetup}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{l:T 'IP 범위'}" VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource SectionTitle}" />
                            <TextBox Text="{Binding RangeText, UpdateSourceTrigger=PropertyChanged}" Width="260" VerticalAlignment="Center"
                                     ToolTip="{l:T '예) 192.168.0.0/24, 192.168.0.1-192.168.0.50, 192.168.0.1-50'}" />
                        </StackPanel>
                        <WrapPanel Margin="0,10,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,2,20,2">
                                <TextBlock Text="{l:T '동시 실행'}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <ComboBox ItemsSource="{Binding ConcurrencyChoices}" SelectedItem="{Binding MaxConcurrency}" Width="80" />
                            </StackPanel>
                            <CheckBox Content="{l:T '이름 찾기 (역방향 DNS)'}" IsChecked="{Binding ResolveNames}" VerticalAlignment="Center" Margin="0,2,20,2"
                                      ToolTip="{l:T '장치 이름을 역방향 DNS 로 찾습니다. 느려질 수 있으면 끄세요.'}" />
                        </WrapPanel>
                        <StackPanel Margin="0,10,0,0">
                            <TextBlock Text="{l:T '제외할 IP (쉼표·공백·줄바꿈으로 구분)'}" Style="{StaticResource HintText}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding ExcludeText, UpdateSourceTrigger=PropertyChanged}" Width="430" HorizontalAlignment="Left"
                                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="24" MaxHeight="70" VerticalScrollBarVisibility="Auto"
                                     ToolTip="{l:T '여기 적은 주소는 핑을 보내지 않고 건너뜁니다.'}" />
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- ===== ② 진행·도구 모음 ===== -->
        <DockPanel Grid.Row="1" Margin="2,0,2,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="{l:T 'CSV로 저장'}" Command="{Binding SaveCsvCommand}" Padding="10,3" Margin="8,0,0,0" />
                <Button Content="{l:T '결과 지우기'}" Command="{Binding ClearCommand}" Padding="10,3" Margin="8,0,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{l:T '찾은 장치'}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding FoundCount}" FontWeight="SemiBold" Margin="6,0,16,0" VerticalAlignment="Center" />
                <ProgressBar Width="200" Height="8" Minimum="0" Maximum="100" Value="{Binding ProgressValue}" VerticalAlignment="Center"
                             Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{Binding ProgressText}" Foreground="{StaticResource TextSecondaryBrush}" Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </DockPanel>

        <!-- ===== ③ 결과 ===== -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <DataGrid ItemsSource="{Binding ResultsView}" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserResizeRows="False"
                      CanUserSortColumns="True" SelectionMode="Extended" BorderThickness="0" Background="Transparent">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{l:T 'IP 주소'}" Binding="{Binding Ip}" SortMemberPath="IpValue" Width="150" />
                    <DataGridTextColumn Header="{l:T '응답(ms)'}" Binding="{Binding ResponseMs}" Width="90" />
                    <DataGridTextColumn Header="TTL" Binding="{Binding TtlText}" Width="70" />
                    <DataGridTextColumn Header="{l:T 'MAC 주소'}" Binding="{Binding Mac}" Width="170" />
                    <DataGridTextColumn Header="{l:T '제조사'}" Binding="{Binding Vendor}" Width="180" />
                    <DataGridTextColumn Header="{l:T '이름'}" Binding="{Binding HostName}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ===== ④ 안내와 상태 ===== -->
        <StackPanel Grid.Row="3" Margin="2,8,2,0">
            <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap"
                       Text="{l:T '핑(ICMP)으로 살아 있는 장치만 찾습니다. 포트 검사·서비스 탐지는 하지 않습니다. 본인 소유이거나 검색 권한이 있는 네트워크만 검색하세요.'}" />
            <TextBlock Text="{Binding StatusText}" Margin="0,4,0,0" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="{x:Type TextBlock}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
    </Grid>
</UserControl>
