<UserControl x:Class="SunTool.Modules.EventLogViewer.Views.EventLogViewerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:SunTool.Wpf.Localization;assembly=SunTool.Wpf"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SunTool.Modules.EventLogViewer.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:EventLogViewerViewModel}"
             d:DesignWidth="1100" d:DesignHeight="720">

    <UserControl.Resources>
        <!-- 수준 요약 칩 -->
        <Style x:Key="LevelChip" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="ToolTip" Value="{l:T '클릭하면 이 수준만 표시합니다'}" />
        </Style>

        <Style x:Key="GroupLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <!-- 수준 아이콘 + 글자 (로그 목록·정의 목록 공용: LevelKind, LevelText 속성 사용) -->
        <DataTemplate x:Key="LevelCell">
            <StackPanel Orientation="Horizontal" Margin="2,0">
                <TextBlock x:Name="Icon" Text="&#xE946;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource AccentBrush}"
                           VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBlock Text="{Binding LevelText}" VerticalAlignment="Center" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding LevelKind}" Value="Critical">
                    <Setter TargetName="Icon" Property="Text" Value="&#xEA39;" />
                    <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource DangerBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding LevelKind}" Value="Error">
                    <Setter TargetName="Icon" Property="Text" Value="&#xE783;" />
                    <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource DangerBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding LevelKind}" Value="Warning">
                    <Setter TargetName="Icon" Property="Text" Value="&#xE7BA;" />
                    <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource WarningBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style TargetType="{x:Type TabItem}">
            <Setter Property="Padding" Value="16,6" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </UserControl.Resources>

    <TabControl Margin="12,10,12,12" SelectedIndex="{Binding SelectedTab}" Background="Transparent" BorderThickness="0,1,0,0">
    <TabItem Header="{l:T '로그 조회'}">
    <Grid Margin="4,12,4,4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="120" />
            <RowDefinition Height="8" />
            <RowDefinition Height="190" MinHeight="80" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== 조회 조건 ===== -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 1행: 기간 + 수준 -->
                <WrapPanel Grid.Row="0" VerticalAlignment="Center">
                    <TextBlock Text="{l:T '기간'}" Style="{StaticResource GroupLabel}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <DatePicker SelectedDate="{Binding FromDate}" Width="125" VerticalContentAlignment="Center" />
                    <TextBlock Text="~" Margin="6,0" VerticalAlignment="Center" />
                    <DatePicker SelectedDate="{Binding ToDate}" Width="125" VerticalContentAlignment="Center" Margin="0,0,10,0" />
                    <Button Content="{l:T '오늘'}" Command="{Binding SetRangeCommand}" CommandParameter="today" Padding="10,4" Margin="0,0,4,0" />
                    <Button Content="{l:T '1주'}" Command="{Binding SetRangeCommand}" CommandParameter="week" Padding="10,4" Margin="0,0,4,0" />
                    <Button Content="{l:T '1개월'}" Command="{Binding SetRangeCommand}" CommandParameter="month" Padding="10,4" Margin="0,0,4,0" />
                    <Button Content="{l:T '3개월'}" Command="{Binding SetRangeCommand}" CommandParameter="3months" Padding="10,4" Margin="0,0,24,0" />

                    <TextBlock Text="{l:T '수준'}" Style="{StaticResource GroupLabel}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <CheckBox IsChecked="{Binding IncludeCritical}" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEA39;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock Text="{l:T '위험'}" VerticalAlignment="Center" />
                        </StackPanel>
                    </CheckBox>
                    <CheckBox IsChecked="{Binding IncludeError}" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE783;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock Text="{l:T '오류'}" VerticalAlignment="Center" />
                        </StackPanel>
                    </CheckBox>
                    <CheckBox IsChecked="{Binding IncludeWarning}" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource WarningBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock Text="{l:T '경고'}" VerticalAlignment="Center" />
                        </StackPanel>
                    </CheckBox>
                    <CheckBox IsChecked="{Binding IncludeInformation}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock Text="{l:T '정보'}" VerticalAlignment="Center" />
                        </StackPanel>
                    </CheckBox>
                </WrapPanel>

                <!-- 2행: 로그 + 최대 개수 + 버튼 -->
                <DockPanel Grid.Row="2">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="{l:T '이벤트 뷰어 열기'}" Command="{Binding OpenEventViewerCommand}" Margin="0,0,6,0" />
                        <Button Content="{l:T '취소'}" Command="{Binding CancelCommand}" Style="{StaticResource DangerButton}" Margin="0,0,6,0" />
                        <Button Content="{l:T '조회'}" Command="{Binding SearchCommand}" Style="{StaticResource AccentButton}" MinWidth="90" />
                    </StackPanel>
                    <WrapPanel VerticalAlignment="Center">
                        <TextBlock Text="{l:T '로그'}" Style="{StaticResource GroupLabel}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <ItemsControl ItemsSource="{Binding Channels}" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:LogChannelOption}">
                                    <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsSelected}" ToolTip="{Binding Hint}" Margin="0,0,12,0" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{l:T '최대'}" Style="{StaticResource GroupLabel}" Margin="12,0,6,0" />
                        <TextBox Text="{Binding MaxResults, UpdateSourceTrigger=PropertyChanged}" Width="70" ToolTip="{l:T '최신 이벤트부터 이 개수까지만 가져옵니다'}" />
                        <TextBlock Text="{l:T '건'}" Style="{StaticResource GroupLabel}" Margin="4,0,0,0" />
                    </WrapPanel>
                </DockPanel>
            </Grid>
        </Border>

        <!-- ===== 요약 칩 + 검색 ===== -->
        <DockPanel Grid.Row="1" Margin="0,12,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Grid Width="220" Margin="0,0,6,0">
                    <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=250}" />
                    <TextBlock Text="{l:T '결과 내 검색 (메시지·원본·ID)'}" Style="{StaticResource HintText}" Margin="8,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Visibility>
                            <Binding Path="Text" ElementName="SearchBox" Converter="{StaticResource NotEmptyToVis}" ConverterParameter="Invert" />
                        </TextBlock.Visibility>
                    </TextBlock>
                </Grid>
                <Button Content="{l:T 'CSV로 저장'}" Command="{Binding ExportCsvCommand}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource LevelChip}" Command="{Binding ShowLevelCommand}" CommandParameter="all">
                    <TextBlock><Run Text="{l:T '전체 '}" /><Run Text="{Binding TotalCount, Mode=OneWay, StringFormat=N0}" FontWeight="Bold" /></TextBlock>
                </Button>
                <Button Style="{StaticResource LevelChip}" Command="{Binding ShowLevelCommand}" CommandParameter="critical">
                    <TextBlock Foreground="{StaticResource DangerBrush}"><Run Text="{l:T '위험 '}" /><Run Text="{Binding CriticalCount, Mode=OneWay, StringFormat=N0}" FontWeight="Bold" /></TextBlock>
                </Button>
                <Button Style="{StaticResource LevelChip}" Command="{Binding ShowLevelCommand}" CommandParameter="error">
                    <TextBlock Foreground="{StaticResource DangerBrush}"><Run Text="{l:T '오류 '}" /><Run Text="{Binding ErrorCount, Mode=OneWay, StringFormat=N0}" FontWeight="Bold" /></TextBlock>
                </Button>
                <Button Style="{StaticResource LevelChip}" Command="{Binding ShowLevelCommand}" CommandParameter="warning">
                    <TextBlock Foreground="{StaticResource WarningBrush}"><Run Text="{l:T '경고 '}" /><Run Text="{Binding WarningCount, Mode=OneWay, StringFormat=N0}" FontWeight="Bold" /></TextBlock>
                </Button>
                <Button Style="{StaticResource LevelChip}" Command="{Binding ShowLevelCommand}" CommandParameter="information">
                    <TextBlock Foreground="{StaticResource AccentBrush}"><Run Text="{l:T '정보 '}" /><Run Text="{Binding InformationCount, Mode=OneWay, StringFormat=N0}" FontWeight="Bold" /></TextBlock>
                </Button>
                <TextBlock VerticalAlignment="Center" Style="{StaticResource HintText}" Margin="6,0,0,0">
                    <Run Text="{l:T '표시 중 '}" /><Run Text="{Binding Entries.Count, Mode=OneWay, StringFormat=N0}" /><Run Text="{l:T '건'}" />
                </TextBlock>
            </StackPanel>
        </DockPanel>

        <!-- ===== 결과 목록 ===== -->
        <Grid Grid.Row="2">
            <DataGrid ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}"
                      AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                      CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="True"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEF0F3"
                      BorderBrush="{StaticResource LineBrush}" Background="{StaticResource SurfaceBrush}" RowHeaderWidth="0"
                      EnableRowVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling">
                <DataGrid.RowStyle>
                    <Style TargetType="{x:Type DataGridRow}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding LevelKind}" Value="Critical">
                                <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="{l:T '수준'}" Width="78" SortMemberPath="Level" CellTemplate="{StaticResource LevelCell}" />
                    <DataGridTextColumn Header="{l:T '날짜 및 시간'}" Binding="{Binding TimeText}" SortMemberPath="TimeCreated" Width="140" />
                    <DataGridTextColumn Header="{l:T '로그'}" Binding="{Binding LogDisplayName}" Width="90" />
                    <DataGridTextColumn Header="{l:T '원본'}" Binding="{Binding ProviderName}" Width="180" />
                    <DataGridTextColumn Header="{l:T '이벤트 ID'}" Binding="{Binding EventId}" Width="70" />
                    <DataGridTextColumn Header="{l:T '작업 범주'}" Binding="{Binding TaskCategory}" Width="110" />
                    <DataGridTextColumn Header="{l:T '내용'}" Binding="{Binding Summary}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>

            <!-- 조회 전 안내 -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                        Visibility="{Binding HasResult, Converter={StaticResource BoolToVisEx}, ConverterParameter=Invert}">
                <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="36" Foreground="{StaticResource LineStrongBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="{l:T '기간·수준·로그를 고르고 [조회]를 누르세요'}" Style="{StaticResource HintText}" FontSize="14" Margin="0,10,0,0" HorizontalAlignment="Center" />
                <TextBlock Text="{l:T '기본 기간은 최근 한 달입니다'}" Style="{StaticResource HintText}" Margin="0,4,0,0" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <GridSplitter Grid.Row="3" HorizontalAlignment="Stretch" VerticalAlignment="Center" Height="4" Background="{StaticResource LineBrush}" />

        <!-- ===== 상세 ===== -->
        <DockPanel Grid.Row="4">
            <DockPanel DockPanel.Dock="Top" Margin="0,2,0,6">
                <Button DockPanel.Dock="Right" Content="{l:T '내용 복사'}" Command="{Binding CopySelectedCommand}" Padding="10,3" />
                <Button DockPanel.Dock="Right" Command="{Binding LookupSelectedCommand}" Padding="10,3" Margin="0,0,6,0"
                        ToolTip="{l:T '이 이벤트의 원본과 ID로 Windows에 등록된 정의를 찾습니다'}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{l:T '이 ID 정의 보기'}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <TextBlock Text="{l:T '선택한 이벤트 상세'}" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
            <TextBox Text="{Binding SelectedEntry.Details, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Padding="10,8"
                     Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" />
        </DockPanel>

        <!-- ===== 상태 ===== -->
        <DockPanel Grid.Row="5" Margin="0,8,0,0">
            <ProgressBar DockPanel.Dock="Right" Width="160" IsIndeterminate="True" VerticalAlignment="Center"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource HintText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        </DockPanel>
    </Grid>
    </TabItem>

    <!-- ===================== 이벤트 ID 검색 ===================== -->
    <TabItem Header="{l:T '이벤트 ID 검색'}">
        <Grid Margin="4,12,4,4" DataContext="{Binding Lookup}" d:DataContext="{d:DesignInstance Type=vm:EventIdLookupViewModel}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="120" />
                <RowDefinition Height="8" />
                <RowDefinition Height="200" MinHeight="80" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,12">
                <StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="{l:T '웹에서 찾기'}" Command="{Binding SearchWebCommand}" Margin="0,0,6,0"
                                    ToolTip="{l:T '원인·해결 방법은 Windows에 들어 있지 않아 Microsoft Learn 검색을 브라우저로 엽니다'}" />
                            <Button Content="{l:T '정의 목록 다시 만들기'}" Command="{Binding RebuildCommand}" Margin="0,0,6,0"
                                    ToolTip="{l:T '프로그램을 새로 설치해 이벤트 원본이 늘었을 때 사용합니다'}" />
                            <Button Content="{l:T '검색'}" Command="{Binding SearchCommand}" Style="{StaticResource AccentButton}" MinWidth="90" />
                        </StackPanel>
                        <WrapPanel VerticalAlignment="Center">
                            <TextBlock Text="{l:T '이벤트 ID'}" Style="{StaticResource GroupLabel}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBox Text="{Binding EventIdText, UpdateSourceTrigger=PropertyChanged}" Width="100" Margin="0,0,16,0">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <TextBlock Text="{l:T '원본 (선택)'}" Style="{StaticResource GroupLabel}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBox Text="{Binding ProviderText, UpdateSourceTrigger=PropertyChanged}" Width="280"
                                     ToolTip="{l:T '예: Service Control Manager, Kernel-Power — 이름 일부만 넣어도 됩니다'}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                        </WrapPanel>
                    </DockPanel>
                    <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,10,0,0"
                               Text="{l:T '같은 이벤트 ID라도 원본(공급자)마다 뜻이 다릅니다. 원본 이름 일부를 함께 넣으면 정확히 좁혀집니다. ID 없이 원본만 넣으면 그 원본의 모든 이벤트를 보여 줍니다. 인터넷 없이 이 PC의 Windows 정보만 사용합니다.'}" />
                </StackPanel>
            </Border>

            <Grid Grid.Row="1">
                <DataGrid ItemsSource="{Binding Results}" SelectedItem="{Binding Selected}"
                          AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                          CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEF0F3"
                          BorderBrush="{StaticResource LineBrush}" Background="{StaticResource SurfaceBrush}" RowHeaderWidth="0"
                          EnableRowVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{l:T '원본'}" Binding="{Binding ProviderName}" Width="230" />
                        <DataGridTextColumn Header="{l:T '이벤트 ID'}" Binding="{Binding EventId}" Width="70" />
                        <DataGridTemplateColumn Header="{l:T '수준'}" Width="90" SortMemberPath="Level" CellTemplate="{StaticResource LevelCell}" />
                        <DataGridTextColumn Header="{l:T '작업 범주'}" Binding="{Binding Task}" Width="110" />
                        <DataGridTextColumn Header="{l:T '설명 (메시지 형식)'}" Binding="{Binding Summary}" Width="*" />
                        <DataGridTextColumn Header="{l:T '출처'}" Binding="{Binding SourceText}" Width="85" />
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                            Visibility="{Binding HasSearched, Converter={StaticResource BoolToVisEx}, ConverterParameter=Invert}">
                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="36" Foreground="{StaticResource LineStrongBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="{l:T '이벤트 ID를 넣고 [검색] (예: 41, 7000, 10016)'}" Style="{StaticResource HintText}" FontSize="14" Margin="0,10,0,0" HorizontalAlignment="Center" />
                    <TextBlock Text="{l:T '로그 조회 탭에서 [이 ID 정의 보기]를 눌러도 됩니다'}" Style="{StaticResource HintText}" Margin="0,4,0,0" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>

            <GridSplitter Grid.Row="2" HorizontalAlignment="Stretch" VerticalAlignment="Center" Height="4" Background="{StaticResource LineBrush}" />

            <DockPanel Grid.Row="3">
                <DockPanel DockPanel.Dock="Top" Margin="0,2,0,6">
                    <Button DockPanel.Dock="Right" Content="{l:T '내용 복사'}" Command="{Binding CopySelectedCommand}" Padding="10,3" />
                    <TextBlock Text="{l:T '선택한 정의'}" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
                <TextBox Text="{Binding Selected.Details, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Padding="10,8"
                         Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" />
            </DockPanel>

            <DockPanel Grid.Row="4" Margin="0,8,0,0">
                <TextBlock DockPanel.Dock="Right" Text="{Binding CatalogInfo}" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="12,0,0,0" />
                <ProgressBar DockPanel.Dock="Right" Width="160" Maximum="100" Value="{Binding ProgressValue, Mode=OneWay}" VerticalAlignment="Center"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource HintText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </DockPanel>
        </Grid>
    </TabItem>
    </TabControl>
</UserControl>
