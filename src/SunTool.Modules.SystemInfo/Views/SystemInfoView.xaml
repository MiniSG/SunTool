<UserControl x:Class="SunTool.Modules.SystemInfo.Views.SystemInfoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:SunTool.Wpf.Localization;assembly=SunTool.Wpf"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SunTool.Modules.SystemInfo.ViewModels"
             xmlns:logic="clr-namespace:SunTool.Modules.SystemInfo.Logic"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SystemInfoViewModel}"
             d:DesignWidth="1100" d:DesignHeight="720">

    <UserControl.Resources>
        <!-- 값은 선택해서 복사할 수 있도록 읽기 전용 TextBox -->
        <Style x:Key="ValueBox" TargetType="{x:Type TextBox}">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- 상태 배지 -->
        <Style x:Key="Badge" TargetType="{x:Type Border}">
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="8,1" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="#EEF0F3" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Ok">
                    <Setter Property="Background" Value="#E6F4EA" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Installed">
                    <Setter Property="Background" Value="#E6F4EA" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Warning">
                    <Setter Property="Background" Value="{StaticResource WarningSoftBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Error">
                    <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BadgeText" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Ok">
                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Installed">
                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Warning">
                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Error">
                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 정보 한 줄 -->
        <DataTemplate x:Key="ItemTemplate" DataType="{x:Type logic:InfoItem}">
            <Border BorderBrush="#EEF0F3" BorderThickness="0,0,0,1" Padding="0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="80" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap" VerticalAlignment="Top" Margin="0,0,12,0" />
                    <StackPanel Grid.Column="1">
                        <TextBox Text="{Binding Value, Mode=OneWay}" Style="{StaticResource ValueBox}" FontWeight="SemiBold" />
                        <TextBox Text="{Binding Detail, Mode=OneWay}" Style="{StaticResource ValueBox}" FontSize="11.5"
                                 Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"
                                 Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                    <Border Grid.Column="2" Style="{StaticResource Badge}" Margin="8,0,0,0"
                            Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource BadgeText}" />
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== 도구 모음 ===== -->
        <DockPanel Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="{l:T '감지 목록 편집'}" Command="{Binding OpenDefinitionFileCommand}" Margin="0,0,6,0"
                        ToolTip="{Binding DefinitionFileHint}" />
                <Button Content="{l:T '전체 복사'}" Command="{Binding CopyAllCommand}" Margin="0,0,6,0" />
                <Button Content="{l:T 'CSV로 저장'}" Command="{Binding ExportCsvCommand}" Margin="0,0,6,0" />
                <Button Command="{Binding RefreshCommand}" Style="{StaticResource AccentButton}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{l:T '새로고침'}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <ProgressBar DockPanel.Dock="Left" Width="120" IsIndeterminate="True" VerticalAlignment="Center" Margin="0,0,10,0"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource HintText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <!-- ===== 분류 목록 ===== -->
        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}" Padding="6">
            <ListBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                     BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="{x:Type ListBoxItem}">
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Padding="10,9" Margin="0,1">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceAltBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:InfoCategoryViewModel}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="{Binding IconGlyph}" FontFamily="{StaticResource IconFont}" FontSize="15"
                                       Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding StateText}" Style="{StaticResource HintText}" FontSize="11" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- ===== 선택한 분류의 정보 ===== -->
        <ScrollViewer Grid.Row="1" Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="{Binding SelectedCategory.Title}" FontSize="18" FontWeight="SemiBold" Margin="2,0,0,10" />
                <TextBlock Text="{l:T '정보를 수집하는 중입니다...'}" Style="{StaticResource HintText}" FontSize="14" Margin="2,10,0,0"
                           Visibility="{Binding SelectedCategory.IsLoading, Converter={StaticResource BoolToVis}}" />
                <ItemsControl ItemsSource="{Binding SelectedCategory.Sections}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type logic:InfoSection}">
                            <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="16,12">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                                    <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource ItemTemplate}" />
                                    <TextBlock Text="{Binding Note}" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,8,0,0"
                                               Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
