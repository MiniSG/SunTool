<UserControl x:Class="SunTool.Modules.BatchRename.Views.BatchRenameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:SunTool.Wpf.Localization;assembly=SunTool.Wpf"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SunTool.Modules.BatchRename.ViewModels"
             xmlns:logic="clr-namespace:SunTool.Modules.BatchRename.Logic"
             xmlns:rules="clr-namespace:SunTool.Modules.BatchRename.Logic.Rules"
             xmlns:b="clr-namespace:SunTool.Wpf.Behaviors;assembly=SunTool.Wpf"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:BatchRenameViewModel}"
             d:DesignWidth="1100" d:DesignHeight="720">

    <UserControl.Resources>
        <!-- 공통: 텍스트 위치 선택 + 위치/기준 문자 입력 (InsertTextRule, NumberingRule 공용) -->
        <DataTemplate x:Key="PositionEditor">
            <StackPanel>
                <TextBlock Text="{l:T '넣을 위치'}" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{x:Static logic:RenameChoices.TextPositions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                          SelectedValue="{Binding Position}" />
                <StackPanel Visibility="{Binding Position, Converter={StaticResource EnumToVis}, ConverterParameter=AtIndex}">
                    <TextBlock Text="{l:T '글자 위치 (0 = 맨 앞)'}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Index, UpdateSourceTrigger=PropertyChanged}" />
                    <CheckBox Content="{l:T '끝에서부터 세기'}" IsChecked="{Binding FromEnd}" />
                </StackPanel>
                <StackPanel Visibility="{Binding Position, Converter={StaticResource EnumToVis}, ConverterParameter='BeforeText,AfterText'}">
                    <TextBlock Text="{l:T '기준 문자 (처음 나오는 위치 기준, 없으면 변경 안 함)'}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding AnchorText, UpdateSourceTrigger=PropertyChanged}" />
                    <CheckBox Content="{l:T '대소문자 무시'}" IsChecked="{Binding IgnoreCase}" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!-- 규칙별 편집 화면 -->
        <DataTemplate DataType="{x:Type rules:InsertTextRule}">
            <StackPanel>
                <TextBlock Text="{l:T '넣을 텍스트'}" Style="{StaticResource FieldLabel}" Margin="0,0,0,3" />
                <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" />
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PositionEditor}" Focusable="False" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type rules:NumberingRule}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{l:T '시작 번호'}" Style="{StaticResource FieldLabel}" Margin="0,0,0,3" />
                        <TextBox Text="{Binding Start, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{l:T '증가값'}" Style="{StaticResource FieldLabel}" Margin="0,0,0,3" />
                        <TextBox Text="{Binding Step, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="{l:T '자릿수 (3 → 001)'}" Style="{StaticResource FieldLabel}" Margin="0,0,0,3" />
                        <TextBox Text="{Binding Padding, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>
                <TextBlock Style="{StaticResource FieldLabel}">
                    <TextBlock.Text><l:T Key="{}번호 서식 ({n} 자리에 번호, 예: _{n}  ({n})  -{n}-)" /></TextBlock.Text>
                </TextBlock>
                <TextBox Text="{Binding Format, UpdateSourceTrigger=PropertyChanged}" />
                <CheckBox Content="{l:T '기존 이름을 지우고 번호(서식)만 사용'}" IsChecked="{Binding ReplaceName}" Margin="0,8,0,0" />
                <CheckBox Content="{l:T '폴더마다 번호를 새로 시작 (하위 폴더 포함 시)'}" IsChecked="{Binding PerFolder}" />
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PositionEditor}" Focusable="False"
                                IsEnabled="{Binding ReplaceName, Converter={StaticResource InverseBool}}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type rules:ReplaceRule}">
            <StackPanel>
                <TextBlock Text="{l:T '찾을 문자열'}" Style="{StaticResource FieldLabel}" Margin="0,0,0,3" />
                <TextBox Text="{Binding Find, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="{l:T '바꿀 문자열 (비우면 삭제)'}" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding ReplaceWith, UpdateSourceTrigger=PropertyChanged}" />
                <CheckBox Content="{l:T '정규식 사용 (바꿀 문자열에서 $1 등 사용 가능)'}" IsChecked="{Binding UseRegex}" Margin="0,8,0,0" />
                <CheckBox Content="{l:T '대소문자 무시'}" IsChecked="{Binding IgnoreCase}" />
                <CheckBox Content="{l:T '처음 하나만 바꾸기'}" IsChecked="{Binding FirstOnly}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type rules:RemoveRule}">
            <StackPanel>
                <TextBlock Text="{l:T '삭제 방식'}" Style="{StaticResource FieldLabel}" Margin="0,0,0,3" />
                <ComboBox ItemsSource="{x:Static logic:RenameChoices.RemoveModes}" DisplayMemberPath="Label" SelectedValuePath="Value"
                          SelectedValue="{Binding Mode}" />
                <StackPanel Visibility="{Binding Mode, Converter={StaticResource EnumToVis}, ConverterParameter=Text}">
                    <TextBlock Text="{l:T '지울 문자열 (모두 지움)'}" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" />
                    <CheckBox Content="{l:T '대소문자 무시'}" IsChecked="{Binding IgnoreCase}" />
                </StackPanel>
                <StackPanel Visibility="{Binding Mode, Converter={StaticResource EnumToVis}, ConverterParameter=Range}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{l:T '시작 위치 (0 = 맨 앞)'}" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding StartIndex, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{l:T '글자 수'}" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Length, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>
                    <CheckBox Content="{l:T '끝에서부터 세기'}" IsChecked="{Binding FromEnd}" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type rules:CaseRule}">
            <StackPanel>
                <TextBlock Text="{l:T '변환 방식'}" Style="{StaticResource FieldLabel}" Margin="0,0,0,3" />
                <ComboBox ItemsSource="{x:Static logic:RenameChoices.CaseModes}" DisplayMemberPath="Label" SelectedValuePath="Value"
                          SelectedValue="{Binding Mode}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type rules:TemplateRule}">
            <StackPanel>
                <TextBlock Text="{l:T '서식'}" Style="{StaticResource FieldLabel}" Margin="0,0,0,3" />
                <TextBox Text="{Binding Template, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}" />
                <TextBlock Text="{x:Static rules:TemplateRule.TokenHelp}" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource FieldLabel}">
                            <TextBlock.Text><l:T Key="{}{n} 시작 번호" /></TextBlock.Text>
                        </TextBlock>
                        <TextBox Text="{Binding Start, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource FieldLabel}">
                            <TextBlock.Text><l:T Key="{}{n} 증가값" /></TextBlock.Text>
                        </TextBlock>
                        <TextBox Text="{Binding Step, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>
                <CheckBox Content="{l:T '폴더마다 번호를 새로 시작'}" IsChecked="{Binding PerFolder}" Margin="0,6,0,0" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="2*" MinWidth="360" />
        </Grid.ColumnDefinitions>

        <!-- ===== 왼쪽: 파일 목록 + 미리보기 ===== -->
        <Border Grid.Column="0" Style="{StaticResource Card}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" Text="{l:T '① 대상 파일'}" />

                <Border DockPanel.Dock="Top" Style="{StaticResource DropZone}" Margin="0,0,0,10"
                        b:DropBehavior.Command="{Binding DropCommand}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="{l:T '폴더 추가...'}" Command="{Binding BrowseFolderCommand}" Margin="0,0,6,0" />
                            <Button Content="{l:T '비우기'}" Command="{Binding ClearFilesCommand}" />
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Left" Text="&#xE8AC;" FontFamily="{StaticResource IconFont}" FontSize="24"
                                   Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="2,0,12,0" />
                        <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock Text="{l:T '폴더나 파일을 끌어다 놓으세요 (여러 번 추가 가능)'}" Style="{StaticResource HintText}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding SourceDisplay}" FontWeight="SemiBold" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- 수집/정렬 옵션 -->
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <CheckBox Content="{l:T '하위 폴더의 파일 포함'}" IsChecked="{Binding IncludeSubfolders}" Margin="0,0,14,4" />
                    <CheckBox Content="{l:T '숨김/시스템 파일 제외'}" IsChecked="{Binding SkipHidden}" Margin="0,0,14,4" />
                    <TextBlock Text="{l:T '확장자'}" VerticalAlignment="Center" Margin="0,0,6,4" />
                    <TextBox Text="{Binding ExtensionFilter, UpdateSourceTrigger=PropertyChanged, Delay=400}" Width="110" Margin="0,0,14,4"
                             ToolTip="{l:T '예: jpg;png (비우면 전체)'}" />
                    <TextBlock Text="{l:T '정렬'}" VerticalAlignment="Center" Margin="0,0,6,4" />
                    <ComboBox ItemsSource="{Binding SortKeys}" DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding SortKey}" Width="190" Margin="0,0,6,4" />
                    <CheckBox Content="{l:T '내림차순'}" IsChecked="{Binding SortDescending}" Margin="0,0,14,4" />
                    <CheckBox Content="{l:T '확장자도 규칙 적용'}" IsChecked="{Binding IncludeExtension}" Margin="0,0,0,4"
                              ToolTip="{l:T '끄면(기본) 확장자를 제외한 이름에만 규칙을 적용합니다.'}" />
                </WrapPanel>

                <!-- 맨 아래: 실행 (미리보기 바로 아래에 두어 확인 → 실행 흐름이 자연스럽게) -->
                <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="{l:T '마지막 작업 되돌리기'}" Command="{Binding UndoCommand}" Margin="0,0,6,0" />
                        <Button Content="{l:T '이름 바꾸기 실행'}" Command="{Binding ExecuteCommand}" Style="{StaticResource AccentButton}" />
                    </StackPanel>
                    <ProgressBar IsIndeterminate="True" VerticalAlignment="Center" Margin="0,0,12,0"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                </DockPanel>

                <!-- 하단: 순서 조정 + 요약 -->
                <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="&#xE70E;" Style="{StaticResource IconButton}" Command="{Binding MoveRowUpCommand}" ToolTip="{l:T '선택한 파일을 위로 (번호 순서 변경)'}" />
                        <Button Content="&#xE70D;" Style="{StaticResource IconButton}" Command="{Binding MoveRowDownCommand}" ToolTip="{l:T '선택한 파일을 아래로'}" />
                        <Button Content="&#xE711;" Style="{StaticResource IconButton}" Command="{Binding RemoveRowCommand}" ToolTip="{l:T '목록에서 제외 (파일은 그대로)'}" />
                        <Button Content="&#xE72C;" Style="{StaticResource IconButton}" Command="{Binding ReloadFilesCommand}" ToolTip="{l:T '파일 목록 다시 읽기'}" Margin="0" />
                    </StackPanel>
                    <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" FontWeight="SemiBold" />
                </DockPanel>

                <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="False"
                          CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#EEF0F3" BorderBrush="{StaticResource LineBrush}"
                          Background="{StaticResource SurfaceBrush}" RowHeaderWidth="0"
                          EnableRowVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling">
                    <DataGrid.RowStyle>
                        <Style TargetType="{x:Type DataGridRow}">
                            <Setter Property="ToolTip" Value="{Binding Message}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="Unchanged">
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Conflict">
                                    <Setter Property="Background" Value="{StaticResource WarningSoftBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Invalid">
                                    <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Error">
                                    <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{l:T '원래 이름'}" Binding="{Binding OriginalName}" Width="*" />
                        <DataGridTextColumn Header="{l:T '새 이름'}" Binding="{Binding NewName}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="{l:T '상태'}" Binding="{Binding StatusText}" Width="80" />
                        <DataGridTextColumn Header="{l:T '폴더'}" Binding="{Binding Folder}" Width="0.7*" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- ===== 오른쪽: 규칙 ===== -->
        <DockPanel Grid.Column="2">
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" Text="{l:T '② 변환 규칙 (위에서부터 순서대로 적용)'}" />

                    <!-- 규칙 추가 버튼들 -->
                    <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding AvailableRules}" Margin="0,0,0,8">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type logic:RuleDescriptor}">
                                <Button Command="{Binding DataContext.AddRuleCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                        CommandParameter="{Binding}" ToolTip="{Binding Description}" Margin="0,0,6,6" Padding="10,4">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 프리셋 -->
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <TextBlock DockPanel.Dock="Left" Text="{l:T '프리셋'}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Button DockPanel.Dock="Right" Content="{l:T '삭제'}" Command="{Binding DeletePresetCommand}" Margin="6,0,0,0" />
                        <Button DockPanel.Dock="Right" Content="{l:T '저장'}" Command="{Binding SavePresetCommand}" Margin="6,0,0,0" />
                        <Button DockPanel.Dock="Right" Content="{l:T '불러오기'}" Command="{Binding LoadPresetCommand}" Margin="6,0,0,0" />
                        <ComboBox ItemsSource="{Binding PresetNames}" SelectedItem="{Binding SelectedPreset}" />
                    </DockPanel>

                    <!-- 선택한 규칙 편집 -->
                    <Border DockPanel.Dock="Bottom" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Margin="0,0,0,8">
                                <TextBlock.Text>
                                    <Binding Path="SelectedRule.RuleName">
                                        <Binding.StringFormat>
                                            <l:T Key="{}{0} 설정" />
                                        </Binding.StringFormat>
                                        <Binding.FallbackValue>
                                            <l:T Key="규칙을 추가하거나 선택하세요" />
                                        </Binding.FallbackValue>
                                    </Binding>
                                </TextBlock.Text>
                            </TextBlock>
                            <!-- 설정이 길어도 규칙 목록 공간을 남기도록 높이 제한 + 스크롤 -->
                            <ScrollViewer MaxHeight="210" VerticalScrollBarVisibility="Auto" Focusable="False">
                                <ContentControl Content="{Binding SelectedRule}" Focusable="False" Margin="0,0,4,0" />
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <!-- 규칙 목록 (도구 버튼은 가로 한 줄: 창이 낮아도 잘리지 않도록) -->
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                            <Button Content="&#xE70E;" Style="{StaticResource IconButton}" Command="{Binding MoveRuleUpCommand}" ToolTip="{l:T '선택한 규칙을 위로'}" />
                            <Button Content="&#xE70D;" Style="{StaticResource IconButton}" Command="{Binding MoveRuleDownCommand}" ToolTip="{l:T '선택한 규칙을 아래로'}" />
                            <Button Content="&#xE8C8;" Style="{StaticResource IconButton}" Command="{Binding DuplicateRuleCommand}" ToolTip="{l:T '복제'}" />
                            <Button Content="&#xE74D;" Style="{StaticResource IconButton}" Command="{Binding RemoveRuleCommand}" ToolTip="{l:T '삭제'}" />
                            <Button Content="&#xE894;" Style="{StaticResource IconButton}" Command="{Binding ClearRulesCommand}" ToolTip="{l:T '모두 삭제'}" />
                        </StackPanel>
                        <ListBox ItemsSource="{Binding Rules}" SelectedItem="{Binding SelectedRule}" MinHeight="90"
                                 BorderBrush="{StaticResource LineBrush}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type logic:RenameRuleBase}">
                                    <DockPanel Margin="2,4">
                                        <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsEnabled}" VerticalAlignment="Center" Margin="0,0,8,0"
                                                  ToolTip="{l:T '체크 해제하면 이 규칙을 잠시 끕니다.'}" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding RuleName}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Summary}" Style="{StaticResource HintText}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </DockPanel>
            </Border>
        </DockPanel>
    </Grid>
</UserControl>
